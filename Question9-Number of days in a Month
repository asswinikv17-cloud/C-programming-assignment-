#include <stdio.h>
int main()
{
    int year, month, days;

    scanf("%d%d", &year, &month);

    if (year < 1900 || year > 9999 ||
        month < 1 || month > 12)
    {
        printf("0");
    }
    else if (month == 1 || month == 3 || month == 5 ||
             month == 7 || month == 8 || month == 10 ||
             month == 12)
    {
        days = 31;
        printf("%d Days", days);
    }
    else if (month == 4 || month == 6 ||
             month == 9 || month == 11)
    {
        days = 30;
        printf("%d Days", days);
    }
    else if (month == 2)
    {
        if (year % 400 == 0 ||
            (year % 4 == 0 && year % 100 != 0))
        {
            days = 29;
        }
        else
        {
            days = 28;
        }

        printf("%d Days", days);
    }

    return 0;
}
